{
  "name": "n8n-nodes-split",
  "version": "1.0.0",
  "description": "A comprehensive n8n community node for Split (by Harness) feature flag and experimentation platform providing 12 resources and 60+ operations for feature flag management, targeting rules, segments, metrics, audit logs, and rollout plans.",
  "license": "BUSL-1.1",
  "author": {
    "name": "Velocity BPA",
    "email": "licensing@velobpa.com",
    "url": "https://velobpa.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Velocity-BPA/n8n-nodes-split.git"
  },
  "homepage": "https://github.com/Velocity-BPA/n8n-nodes-split#readme",
  "bugs": {
    "url": "https://github.com/Velocity-BPA/n8n-nodes-split/issues"
  },
  "keywords": [
    "n8n",
    "n8n-community-node-package",
    "split",
    "harness",
    "feature-flags",
    "feature-toggles",
    "ab-testing",
    "experimentation",
    "targeting",
    "segments",
    "rollouts",
    "automation"
  ],
  "main": "dist/nodes/Split/Split.node.js",
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SplitApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Split/Split.node.js",
      "dist/nodes/Split/SplitTrigger.node.js"
    ]
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^4.0.2",
    "jest": "^29.7.0",
    "n8n-workflow": "^1.30.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "n8n-workflow": ">=1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
